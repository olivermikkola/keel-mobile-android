            android:action="com.keelmobile.android.ACTION_OPEN_STUDY"
            android:targetPackage="com.keelmobile.android"
            android:targetClass="com.keelmobile.android.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="websites_app"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_websites">
